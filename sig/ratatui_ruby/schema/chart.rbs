module RatatuiRuby
  class Axis < Data
    attr_reader title: String
    attr_reader bounds: [Float, Float]
    attr_reader labels: Array[String]
    attr_reader style: Style?
    attr_reader labels_alignment: Symbol?
    def self.new: (?title: String, ?bounds: [Numeric, Numeric], ?labels: Array[String], ?style: Style?, ?labels_alignment: Symbol?) -> Axis
    def initialize: (?title: String, ?bounds: [Numeric, Numeric], ?labels: Array[String], ?style: Style?, ?labels_alignment: Symbol?) -> void
  end

  class Dataset < Data
    attr_reader name: String | Symbol
    attr_reader data: Array[[Float, Float]]
    attr_reader style: Style?
    attr_reader marker: Symbol
    attr_reader graph_type: Symbol
    def self.new: (name: String | Symbol, data: Array[[Numeric, Numeric]], ?style: Style?, ?marker: Symbol, ?graph_type: Symbol) -> Dataset
    def initialize: (name: String | Symbol, data: Array[[Numeric, Numeric]], ?style: Style?, ?marker: Symbol, ?graph_type: Symbol) -> void
  end

  class Chart < Data
    attr_reader datasets: Array[Dataset]
    attr_reader x_axis: Axis
    attr_reader y_axis: Axis
    attr_reader block: Block?
    attr_reader style: Style?
    attr_reader legend_position: Symbol?
    attr_reader hidden_legend_constraints: Array[Layout::Constraint]
    def self.new: (datasets: Array[Dataset], x_axis: Axis, y_axis: Axis, ?block: Block?, ?style: Style?, ?legend_position: Symbol?, ?hidden_legend_constraints: Array[Layout::Constraint]) -> Chart
    def initialize: (datasets: Array[Dataset], x_axis: Axis, y_axis: Axis, ?block: Block?, ?style: Style?, ?legend_position: Symbol?, ?hidden_legend_constraints: Array[Layout::Constraint]) -> void
  end
end
