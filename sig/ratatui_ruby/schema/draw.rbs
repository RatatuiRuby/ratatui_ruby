module RatatuiRuby
  module Draw
    class StringCmd < Data
      attr_reader x: Integer
      attr_reader y: Integer
      attr_reader string: String
      attr_reader style: style_input

      def self.new: (x: Integer, y: Integer, string: String, style: style_input) -> StringCmd
    end

    class CellCmd < Data
      attr_reader x: Integer
      attr_reader y: Integer
      attr_reader cell: Cell

      def self.new: (x: Integer, y: Integer, cell: Cell) -> CellCmd
    end

    def self.string: (Numeric x, Numeric y, String string, ?style_input style) -> StringCmd
    def self.cell: (Numeric x, Numeric y, Buffer::Cell cell) -> CellCmd
  end
end
