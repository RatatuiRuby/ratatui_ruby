# SPDX-License-Identifier: AGPL-3.0-or-later

module RatatuiRuby
  class Event
    def none?: () -> bool
    def key?: () -> bool
    def mouse?: () -> bool
    def resize?: () -> bool
    def paste?: () -> bool
    def focus_gained?: () -> bool
    def focus_lost?: () -> bool
    def sync?: () -> bool
    def method_missing: (Symbol, *untyped, **untyped) ?{ (?) -> untyped } -> untyped
    def respond_to_missing?: (Symbol, *untyped) -> bool
    def deconstruct_keys: (Array[Symbol]?) -> { }

    type key_kind = :standard | :function | :media | :modifier | :system

    class Sync < Event
      def sync?: () -> bool
      def deconstruct_keys: (Array[Symbol]?) -> { type: :sync }
    end

    class Key < Event
      # Character handling module
      module Character
        def text?: () -> bool
        def char: () -> String?
      end

      # Modifier key detection module
      module Modifier
        def ctrl?: () -> bool
        def alt?: () -> bool
        def shift?: () -> bool
        def super?: () -> bool
        def hyper?: () -> bool
        def meta?: () -> bool
        def modifier?: () -> bool
        private def match_modifier_dwim?: (String key_name, Symbol key_sym) -> bool
      end

      # Media key handling module
      module Media
        def media?: () -> bool
        private def match_media_dwim?: (String key_name) -> bool
      end

      # Navigation key handling module
      module Navigation
        def standard?: () -> bool
        alias unmodified? standard?
        private def match_navigation_dwim?: (String key_name, Symbol key_sym) -> bool
      end

      # System key handling module
      module System
        def system?: () -> bool
        def function?: () -> bool
        private def match_system_dwim?: (String key_name, Symbol key_sym) -> bool
      end

      # DWIM predicates for common key patterns
      module Dwim
        NAVIGATION_KEYS: Array[String]
        ARROW_KEYS: Array[String]
        VIM_MOVEMENT_KEYS: Array[String]
        PUNCTUATION_NAMES: Hash[Symbol, String]

        def space?: () -> bool
        def cr?: () -> bool
        def letter?: () -> bool
        def digit?: () -> bool
        def alphanumeric?: () -> bool
        def punctuation?: () -> bool
        def whitespace?: () -> bool
        def interrupt?: () -> bool
        def eof?: () -> bool
        def cancel?: () -> bool
        def sigint?: () -> bool
        def suspend?: () -> bool
        def quit?: () -> bool
        def navigation?: () -> bool
        def arrow?: () -> bool
        def vim?: () -> bool
        def vim_left?: () -> bool
        def vim_down?: () -> bool
        def vim_up?: () -> bool
        def vim_right?: () -> bool
        def vim_word_forward?: () -> bool
        def vim_word_backward?: () -> bool
        def vim_top?: () -> bool
        def vim_bottom?: () -> bool
        def quote?: () -> bool
      end

      include Character
      include Modifier
      include Media
      include Navigation
      include System
      include Dwim

      attr_reader code: String
      attr_reader modifiers: Array[String]
      attr_reader kind: key_kind

      def initialize: (code: String, ?modifiers: Array[String], ?kind: key_kind) -> void
      def ==: (untyped other) -> bool
      def to_sym: () -> Symbol
      def to_s: () -> String
      def inspect: () -> String
      def ctrl?: () -> bool
      def alt?: () -> bool
      def shift?: () -> bool
      def text?: () -> bool
      def char: () -> String?
      def media?: () -> bool
      def system?: () -> bool
      def function?: () -> bool
      def modifier?: () -> bool
      def standard?: () -> bool
      def unmodified?: () -> bool
      def method_missing: (Symbol, *untyped, **untyped) ?{ (?) -> untyped } -> untyped
      def respond_to_missing?: (Symbol, *untyped) -> bool
      def deconstruct_keys: (Array[Symbol]?) -> { type: :key, code: String, modifiers: Array[String], kind: key_kind }
    end

    class Mouse < Event
      attr_reader kind: String
      attr_reader x: Integer
      attr_reader y: Integer
      attr_reader button: String
      attr_reader modifiers: Array[String]

      def initialize: (kind: String, x: Integer, y: Integer, button: String?, modifiers: Array[String]) -> void
      def down?: () -> bool
      def up?: () -> bool
      def drag?: () -> bool
      def scroll_up?: () -> bool
      def scroll_down?: () -> bool
      def left?: () -> bool
      def right?: () -> bool
      def middle?: () -> bool
      def scroll?: () -> bool
      def moved?: () -> bool
      def hover?: () -> bool
      def hovering?: () -> bool
      def move?: () -> bool
      def primary?: () -> bool
      def secondary?: () -> bool
      def context_menu?: () -> bool
      def aux?: () -> bool
      def auxiliary?: () -> bool
      def wheel_up?: () -> bool
      def wheel_down?: () -> bool
      def release?: () -> bool
      def released?: () -> bool
      def press?: () -> bool
      def pressed?: () -> bool
      def dragging?: () -> bool
      def to_sym: () -> Symbol
      def ==: (top other) -> bool
      def deconstruct_keys: (Array[Symbol]?) -> { type: :mouse, kind: String, x: Integer, y: Integer, button: String, modifiers: Array[String] }
    end

    class Resize < Event
      attr_reader width: Integer
      attr_reader height: Integer

      def initialize: (width: Integer, height: Integer) -> void
      def to_sym: () -> Symbol
      def ==: (top other) -> bool
      def deconstruct_keys: (Array[Symbol]?) -> { type: :resize, width: Integer, height: Integer }

      # DWIM predicates
      VT100_WIDTH: Integer
      VT100_HEIGHT: Integer
      def sigwinch?: () -> bool
      def winch?: () -> bool
      def sig_winch?: () -> bool
      def landscape?: () -> bool
      def portrait?: () -> bool
      def vt100?: () -> bool
      def at_least_vt100?: () -> bool
      def over_vt100?: () -> bool
      def cramped?: () -> bool
      def constrained?: () -> bool
    end

    class Paste < Event
      attr_reader content: String

      def initialize: (content: String) -> void
      def deconstruct_keys: (Array[Symbol]?) -> { type: :paste, content: String }

      # DWIM predicates
      def clipboard?: () -> bool
      def pasteboard?: () -> bool
      def pasted?: () -> bool
      def empty?: () -> bool
      def blank?: () -> bool
      def multiline?: () -> bool
      def multi_line?: () -> bool
      def single_line?: () -> bool
      def singleline?: () -> bool
    end

    class FocusGained < Event
      def deconstruct_keys: (Array[Symbol]?) -> { type: :focus_gained }

      # DWIM predicates
      def focus?: () -> bool
      def gained?: () -> bool
      def lost?: () -> bool
      def blur?: () -> bool
      def active?: () -> bool
      def inactive?: () -> bool
      def foreground?: () -> bool
      def background?: () -> bool
    end

    class FocusLost < Event
      def deconstruct_keys: (Array[Symbol]?) -> { type: :focus_lost }

      # DWIM predicates
      def focus?: () -> bool
      def gained?: () -> bool
      def lost?: () -> bool
      def blur?: () -> bool
      def active?: () -> bool
      def inactive?: () -> bool
      def foreground?: () -> bool
      def background?: () -> bool
    end

    class None < Event
      def none?: () -> bool
      def deconstruct_keys: (Array[Symbol]?) -> { type: :none }
    end
  end
end
