module RatatuiRuby
  module Layout
    class Size < Data
      attr_reader width: Integer
      attr_reader height: Integer

      def self.new: (?width: _ToInt, ?height: _ToInt) -> instance
      def initialize: (?width: _ToInt, ?height: _ToInt) -> void
    end
  end
end
