module RatatuiRuby
  module Layout
    class Position < Data
      attr_reader x: Integer
      attr_reader y: Integer

      def self.new: (?x: _ToInt, ?y: _ToInt) -> instance
      def initialize: (?x: _ToInt, ?y: _ToInt) -> void
    end
  end
end
