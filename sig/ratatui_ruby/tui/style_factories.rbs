module RatatuiRuby
  class TUI
    module StyleFactories
      type color = String | Symbol | Integer

      def style: (?fg: color?, ?bg: color?, ?underline_color: color?, ?modifiers: Array[Symbol], ?remove_modifiers: Array[Symbol]) -> Style::Style
    end
  end
end
