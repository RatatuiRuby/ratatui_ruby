module RatatuiRuby
  class Terminal
    # Environment-based terminal capability detection.
    # Provides class methods for detecting terminal capabilities.
    module Capabilities
      def tty?: () -> bool
      def dumb?: () -> bool
      def no_color?: () -> bool
      def force_color?: () -> bool
      def interactive?: () -> bool
    end

    extend Capabilities
  end
end
