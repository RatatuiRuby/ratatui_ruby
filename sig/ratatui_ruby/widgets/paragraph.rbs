module RatatuiRuby
  module Widgets
    class Paragraph < Data
      attr_reader text: String
      attr_reader style: Style::Style?
      attr_reader block: Block?
      attr_reader wrap: bool
      attr_reader alignment: Symbol
      attr_reader scroll: [Integer, Integer]

      # Legacy constructor with fg/bg convenience params
      def self.new: (text: String, ?style: Style::Style?, ?fg: (String | Symbol)?, ?bg: (String | Symbol)?, ?block: Block?, ?wrap: bool, ?alignment: Symbol, ?scroll: [Numeric, Numeric]) -> Paragraph
      # Instance initialize
      def initialize: (?text: String, ?style: Style::Style?, ?block: Block?, ?wrap: bool, ?alignment: Symbol, ?scroll: Array[Integer]) -> void
      def line_count: (Integer width) -> Integer
      def line_width: () -> Integer
    end
  end
end
