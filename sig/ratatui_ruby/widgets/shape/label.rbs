module RatatuiRuby
  module Widgets
    module Shape
      # Options hash type for Shape::Label constructor arguments.
      type label_options = {
        ?x: Numeric,
        ?y: Numeric,
        ?text: String | Text::Line,
        ?style: Style?
      }

      class Label < Data
        attr_reader x: Float
        attr_reader y: Float
        attr_reader text: String | Text::Line
        attr_reader style: Style?

        include CoerceableWidget

        def self.coerce_args: (label_options first, ?label_options kwargs) -> Label
                            | (nil first, label_options kwargs) -> Label

        def self.new: (x: Numeric, y: Numeric, text: String | Text::Line, ?style: Style?) -> Label
        def initialize: (x: Numeric, y: Numeric, text: String | Text::Line, ?style: Style?) -> void
      end
    end
  end
end
